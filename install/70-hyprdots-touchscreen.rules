# Lets the person at the screen read the touchscreen, and only that, for touch gestures (.config/hypr/tray/touch_gestures.py).
# The input group would do it too, but lets every program read every key pressed. Must sort before 73-seat-late.rules.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHSCREEN}=="1", TAG+="uaccess"
