 /* wallust template - colors-rofi */

* {
active-background: #5F5F73;
active-foreground: #C6C8CF;
normal-background: #2C2D34;
normal-foreground: #C6C8CF;
urgent-background: #5D6175;
urgent-foreground: #C6C8CF;

alternate-active-background: #595E72;
alternate-active-foreground: #C6C8CF;
alternate-normal-background: #2C2D34;
alternate-normal-foreground: #C6C8CF;
alternate-urgent-background: #2C2D34;
alternate-urgent-foreground: #C6C8CF;

selected-active-background: #5D6175;
selected-active-foreground: #C6C8CF;
selected-normal-background: #5D6175;
selected-normal-foreground: #C6C8CF;
selected-urgent-background: #5F5F73;
selected-urgent-foreground: #C6C8CF;

background-color: #2C2D34;
background: rgba(0,0,0,0.7);
foreground: #C6C8CF;
border-color: #5F5F73;

color0: #515259;
color1: #603042;
color2: #5E3243;
color3: #434656;
color4: #474756;
color5: #464958;
color6: #464958;
color7: #A6A8B2;
color8: #74757C;
color9: #804058;
color10: #7E425A;
color11: #595E72;
color12: #5F5F73;
color13: #5D6175;
color14: #5D6175;
color15: #A6A8B2;


}

