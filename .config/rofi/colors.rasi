normal-background: #1B1A1B;
normal-foreground: #F9F8F9;
urgent-background: #E0E0E5;
urgent-foreground: #F9F8F9;

alternate-active-background: #B94C47;
alternate-active-foreground: #F9F8F9;
alternate-normal-background: #1B1A1B;
alternate-normal-foreground: #F9F8F9;
alternate-urgent-background: #1B1A1B;
alternate-urgent-foreground: #F9F8F9;

