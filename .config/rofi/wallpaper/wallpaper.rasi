/* Wallpaper picker: full screen like the app launcher, with each wallpaper shown in its own aspect ratio.
   Colours come from wallust (../colors.rasi). The thumbnail size is set by wallpaper.sh to fit the screen. */

@import "colors.rasi"
@import "shared/fonts.rasi"

configuration {
  modi: "dmenu";
  show-icons: true;
}

window {
  transparency: "real";
  location: center;
  anchor: center;
  fullscreen: true;
  width: 100%;
  height: 100%;
  margin: 0px;
  padding: 0px;
  border: 0px;
  border-radius: 0px;
  background-color: black / 50%;
}

mainbox {
  spacing: 60px;
  padding: 80px 150px;
  background-color: transparent;
  children: [ "inputbar", "listview" ];
}

inputbar {
  spacing: 10px;
  margin: 0% 25%;
  padding: 18px;
  border-radius: 10px;
  background-color: white / 70%;
  text-color: @foreground;
  children: [ "entry" ];
}

entry {
  background-color: transparent;
  text-color: inherit;
  cursor: text;
  placeholder: "Search wallpapers";
  placeholder-color: inherit;
  horizontal-align: 0.5;
}

listview {
  columns: 5;
  lines: 3;
  cycle: true;
  dynamic: true;
  scrollbar: false;
  layout: vertical;
  fixed-height: true;
  fixed-columns: true;
  spacing: 0px;
  margin: 0px;
  padding: 0px;
  border: 0px;
  background-color: transparent;
}

element {
  spacing: 12px;
  margin: 0px;
  padding: 18px 10px;
  border: 0px;
  border-radius: 15px;
  orientation: vertical;
  background-color: transparent;
  text-color: @foreground;
  cursor: pointer;
}

element normal.normal, element alternate.normal, element normal.active, element alternate.active,
element normal.urgent, element alternate.urgent {
  background-color: transparent;
  text-color: @foreground;
}

element selected.normal, element selected.active, element selected.urgent {
  background-color: @color5;
  text-color: @foreground;
}

element-icon {
  size: 220px;
  background-color: transparent;
  horizontal-align: 0.5;
  cursor: inherit;
}

element-text, element-text selected, element-text normal, element-text alternate {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
  horizontal-align: 0.5;
  cursor: inherit;
}
