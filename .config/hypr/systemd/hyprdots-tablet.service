[Unit]
Description=Tablet mode: the on-screen keyboard and auto-rotate while no keyboard is attached
PartOf=graphical-session.target
After=graphical-session.target
OnFailure=hyprdots-part-failed@%n.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/python3 %h/.config/hypr/tray/tablet_mode.py
Restart=on-failure
RestartSec=1
TimeoutStopSec=8
KillMode=process
