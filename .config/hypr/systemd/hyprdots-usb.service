[Unit]
Description=Mounts USB drives, with a notification to open them
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/usr/bin/udiskie
OnFailure=hyprdots-part-failed@%n.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/udiskie -c %h/.config/hypr/udiskie.yml
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
KillMode=process
