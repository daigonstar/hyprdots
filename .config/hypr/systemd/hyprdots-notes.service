[Unit]
Description=Notes: the drop-down scratchpad (Super+I)
PartOf=graphical-session.target
After=graphical-session.target
OnFailure=hyprdots-part-failed@%n.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# The Rust build when it is installed (notes/build.sh), notes.py otherwise
ExecStart=%h/.config/hypr/notes/start.sh
# gtk4-layer-shell has to be loaded before GTK itself
Environment=LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
