[Unit]
Description=Quick tray, volume popups, Alt+Tab and workspace overview
PartOf=graphical-session.target
After=graphical-session.target
OnFailure=hyprdots-part-failed@%n.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/python3 %h/.config/hypr/tray/quick_tray.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
# Apps opened from it live in its cgroup, and must survive it restarting
KillMode=process
