{
    // Modules

    "layer": "top",
        "position": "top",
        "reload_style_on_change": true,
        "spacing": 10,
        "modules-left": ["clock","custom/assistant","group/expand2"],
        "modules-center": ["hyprland/window", "hyprland/workspaces","cava"],
        "modules-right": ["group/expand","pulseaudio","bluetooth","custom/updates","battery","network","custom/power","custom/noti"],

    // Groups

        "group/expand": {
            "orientation": "horizontal",
            "spacing": 10,
            "drawer": {
                "transition-duration": 600,
                "transition-to-left": true,
                "click-to-reveal": true
            },
            "modules": ["custom/trayicon","tray","cpu","memory","temperature"]
        },
        "group/expand2": {
            "orientation": "horizontal",
            "spacing": 10,
            "drawer": {
                "transition-duration": 600,
                "transition-to-left": false,
                "click-to-reveal": true
            },
            "modules": [
                "custom/settingsicon",
                "custom/display",
                "custom/wallpaper",
                "custom/gtk",
                "custom/drive",
                "custom/keys",
                "custom/userconfig"
            ]
        },
    // Generic Modules

    "hyprland/window": {
            "max-length": 10, // Characters count
            "separate-outputs": true,
            "icon": true
        },

        "hyprland/workspaces": {
	    "active-only": false,
	    "all-outputs": false,
	    "format": "{icon}",
	    "show-special": false,
	    "on-click": "activate",
        "persistent-workspaces": {
        "*": 3
	    },
	    "format-icons": {
	    	"active": "",
	    	"default": "",
	        },
        },

        "clock": {
	    "interval": 1,
        //"format": " {:%I:%M %p}", // AM PM format
        "format": "  {:%H:%M}", // 24H
	    "tooltip-format": "{:%A, %d %B %Y}",
	    "on-click": "~/.config/waybar/scripts/popup_calendar.py",
	    "on-click-right": "~/.config/waybar/scripts/popup_calendar.py",
        },

        "network": {
            "format-wifi": "󰖩",
            "format-ethernet":"󰈀",
            "format-disconnected": "",
            "tooltip-format-disconnected": "Error",
            "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
            "tooltip-format-ethernet": "{ifname} 󰈀 ",
            "on-click": "ghostty -e nmtui"
        },

        "bluetooth": {
            "format-on": "󰂯",
            "format-off": "BT-off",
            "format-disabled": "󰂲",
            "format-connected": "󰂱",
            "format-alt": "{device_alias} 󰂯",
            "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
            "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
            "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
            "on-click": "ghostty -e bluetui",
        },

        "battery": {
            "interval":30,
            "states": {
                "good": 95,
                "warning": 30,
                "critical": 20
            },
            "format": "{capacity}% {icon}",
            "format-charging": "{capacity}% 󰂄",
            "format-plugged": "{capacity}% 󰂄 ",
            "format-alt": "{time} {icon}",
            "format-icons": [
                "󰁻",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰂂",
            "󰁹"
            ],
        },

        "cpu": {
            "format": "",
            "tooltip": true
        },

        "memory": {
            "format": ""
        },

        "temperature": {
            "critical-threshold": 80,
            "format": "",
        },

        "tray": {
            "icon-size": 14,
            "spacing": 2,
            "show-passive-items":true
        },

        "pulseaudio": {
        "format": "{icon}   {volume}%  ",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "0% {icon} ",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
        },

    // Custom Modules


        "custom/notification": {
            "tooltip": false,
            "format": "󰎟",
            "on-click": "swaync-client -t -sw",
            "escape": true
        },
        "custom/trayicon": {
            "format": "󱊔",
            "tooltip": false
        },
        "custom/settingsicon": {
            "format": "",
            "tooltip": false
        },
        "custom/endpoint":{
            "format": "|",
            "tooltip": false
        },

        "custom/separator": {
            "format": "|",
            "interval": "once",
            "tooltip": false
        },

        "custom/updates": {
            "exec": "~/.config/waybar/scripts/updates.sh",
            "return-type": "json",
            "interval": 1800,
            "signal": 8,
            "on-click": "ghostty -e bash -ic 'update; pkill -RTMIN+8 waybar'"
        },

        "custom/power": {
            "format": "&#xf011; ",
            "on-click": "~/.config/rofi/powermenu/powermenu.sh",
            "tooltip":false
	    },

        "custom/assistant": {
        "exec-if": "test ! -e \"${XDG_STATE_HOME:-$HOME/.local/state}/hypr_agent/disabled\"",
        "format": "󰙴",
        "on-click": "~/.config/hypr/scripts/assistant-toggle.sh",
        "exec": "echo '{\"tooltip\": \"PC Assistant (AI): ask about your system, updates and problems\"}'",
        "return-type": "json",
        "interval": "once"
        },

        "cava": {
        // "cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
        "framerate": 30,
        "autosens": 0,
        "sensitivity": 0.05,
        "bars": 14,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "hide_on_silence": false,
        // "format_silent": "quiet",
        "method": "pulse",
        "source": "auto",
        "stereo": true,
        "reverse": false,
        "bar_delimiter": 0,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.77,
        "input_delay": 2,
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
        "actions": {
                   "on-click-right": "mode"
                   }
        },
          "custom/noti": {
        "tooltip": true,
        "format": "<span size='16pt'>{icon}</span>",
        "format-icons": {
        "notification": "󱅫",
        "none": "󰂜",
        "dnd-notification": "󰂠",
        "dnd-none": "󰪓",
        "inhibited-notification": "󰂛",
        "inhibited-none": "󰪑",
        "dnd-inhibited-notification": "󰂛",
        "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
        },
        "custom/display": {
            "format": "󰍹",
            "exec": "echo '{\"tooltip\": \"Display settings (nwg-displays)\"}'",
            "return-type": "json",
            "interval": "once",
            "on-click": "nwg-displays"
        },

        "custom/wallpaper": {
            "format": "󰋩",
            "exec": "echo '{\"tooltip\": \"Wallpaper picker\"}'",
            "return-type": "json",
            "interval": "once",
            "on-click": "~/.config/rofi/wallpaper/wallpaper.sh"
        },
        "custom/gtk": {
            "format": "󰏘",
            "exec": "echo '{\"tooltip\": \"GTK theme (nwg-look)\"}'",
            "return-type": "json",
            "interval": "once",
            "on-click": "nwg-look"
        },
        "custom/drive": {
            "format": "󰋊",
            "exec": "echo '{\"tooltip\": \"Disks: format / partition\"}'",
            "return-type": "json",
            "interval": "once",
            "on-click": "partitionmanager"
        },

        "custom/userconfig": {
            "format": "󰒓",
            "exec": "echo '{\"tooltip\": \"Settings: user_settings.toml (shared) and user_settings.local.toml (private, calendar links)\"}'",
            "return-type": "json",
            "interval": "once",
            "on-click": "ghostty -e vim -p ~/.config/hypr/user_settings.toml ~/.config/hypr/user_settings.local.toml"
        },
        "custom/keys": {
            "format": "󰌌",
            "exec": "echo '{\"tooltip\": \"Keybind cheatsheet\"}'",
            "return-type": "json",
            "interval": "once",
            "on-click": "~/.config/rofi/cheatsheet/cheatsheet.sh"
        }
}
